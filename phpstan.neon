includes:
    - vendor/phpstan/phpstan-laravel/extension.neon
    - vendor/nunomaduro/larastan/config/laravel.neon

parameters:
    level: 5
    paths:
        - app
        - routes
        - tests
    
    # Ignore closure parameter types (Laravel conventions)
    ignoreErrors:
        - "#Undefined method 'whereNull'#"
        - "#Undefined method 'orWhere'#"
        - "#Undefined method 'where'#"
        - "#has no return type specified#"
        - "#Parameter \$query of anonymous function has no type hint specified#"
        - "#Parameter \$builder of anonymous function has no type hint specified#"
        - "#Parameter \$ of arrow function has no type hint specified#"
